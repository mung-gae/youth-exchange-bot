{
  "name": "youth-exchange-bot",
  "version": "1.0.0",
  "description": "Discord 이벤트 봇 청춘거래소",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
